# Copy this file to .env.local and fill in your real values
# Next.js automatically loads .env.local in development

# REQUIRED: 64+ character random secret for JWT signing
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=replace-with-your-64-char-random-hex-string

# Optional: override the default admin password (default is 'admin123')
ADMIN_PASSWORD=your-secure-admin-password

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name (optional, defaults to 'chemistshop')
DB_NAME=chemistshop

# Disable auto-seeding of demo products and orders (set to 'true' to keep them)
ENABLE_SAMPLE_PRODUCTS=false

# Cloudinary credentials (required for image uploads)
# Get them from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
